# Ejemplo: configurar en el proceso de Spring, NO en VITE_* ni en el navegador.
SPRING_PROFILES_ACTIVE=neon
NEON_JDBC_URL=jdbc:postgresql://YOUR_NEON_HOST/neondb?sslmode=verify-full&sslfactory=org.postgresql.ssl.DefaultJavaSSLFactory
NEON_DB_USERNAME=YOUR_NEON_ROLE
NEON_DB_PASSWORD=
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
# Activar solo despues de importar, configurar y publicar el webhook de n8n.
N8N_ENABLED=false
N8N_WEBHOOK_URL=https://YOUR_N8N_HOST/webhook/diario-entry-created
N8N_WEBHOOK_TOKEN=
