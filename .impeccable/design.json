  "components": [
    {
      "name": "Botón principal",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Guardar o empezar una entrada.",
      "html": "<button class=\"ds-primary\">Guardar mi día</button>",
      "css": ".ds-primary{font-family:'Inter Variable',sans-serif;border:0;min-height:46px;padding:11px 19px;border-radius:3px;background:var(--action,#242521);color:var(--action-ink,#fff);font-size:15px;font-weight:550;line-height:1.5;cursor:pointer;transition:background .18s ease}.ds-primary:hover{background:var(--ink,#242521)}.ds-primary:focus-visible,.ds-outline:focus-visible,.ds-field:focus-visible,.ds-nav:focus-visible,.ds-mark:focus-visible,.ds-prompt button:focus-visible{outline:3px solid var(--focus,#687653);outline-offset:3px}@media(prefers-reduced-motion:reduce){.ds-primary{transition:none}}"
    },
    {
      "name": "Botón secundario",
      "kind": "button",
      "refersTo": "button-outline",
      "description": "Acciones secundarias sin competir con guardar.",
