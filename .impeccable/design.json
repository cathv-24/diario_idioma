      "css": ".ds-primary{font-family:'Inter Variable',sans-serif;border:0;min-height:46px;padding:11px 19px;border-radius:9px;background:var(--action,#302d28);color:var(--action-ink,#fffdf7);font-size:15px;font-weight:550;line-height:1.5;cursor:pointer;transition:background .18s ease}.ds-primary:hover{background:var(--accent-hover,#3e5136)}.ds-primary:focus-visible,.ds-outline:focus-visible,.ds-field:focus-visible,.ds-nav:focus-visible,.ds-mark:focus-visible,.ds-prompt button:focus-visible{outline:3px solid var(--focus,#647b55);outline-offset:3px}@media(prefers-reduced-motion:reduce){.ds-primary{transition:none}}:host-context([data-theme=\"dark\"]) .ds-primary:hover{background:#ffe4b3}"
